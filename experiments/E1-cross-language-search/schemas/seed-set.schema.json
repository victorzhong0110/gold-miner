{"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "description": "依据 protocol.md 第 3 节种子集字段列表，一行一条。冻结后提交，不增删。", "properties": {"direction": {"description": "en2zh=目标为仅中文 README 的仓库；zh2en=目标为英文 README 的仓库。", "enum": ["en2zh", "zh2en"], "type": "string"}, "frozen_at": {"description": "冻结时间，RFC 3339。", "format": "date-time", "type": "string"}, "hellogithub_issue": {"description": "HelloGitHub 月刊期号。", "minimum": 1, "type": "integer"}, "query": {"description": "按第 3 节步骤 5 写的单条需求句，不抄仓库名。", "minLength": 1, "type": "string"}, "query_lang": {"description": "query 的语言。", "enum": ["zh", "en"], "type": "string"}, "readme_lang": {"description": "第 2 节分类器标签：zh_only=仅中文，bilingual=双语，en=英文，ja=含假名，ko=含韩文。", "enum": ["zh_only", "bilingual", "en", "ja", "ko"], "type": "string"}, "repo": {"description": "仓库全名 owner/repo，原样保存。", "pattern": "^[^/\\s]+/[^/\\s]+$", "type": "string"}, "seed_id": {"description": "种子标识。", "minLength": 1, "type": "string"}, "stars": {"description": "冻结时 stars 数，须 >= 50。", "minimum": 50, "type": "integer"}, "zh_description": {"description": "HelloGitHub 月刊中的中文介绍。", "minLength": 1, "type": "string"}}, "required": ["seed_id", "direction", "repo", "stars", "readme_lang", "hellogithub_issue", "zh_description", "query", "query_lang", "frozen_at"], "title": "E1 seed-set.jsonl 单行记录", "type": "object"}
