{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "type": "object",
  "title": "E1 merged rank row",
  "required": ["run_id", "task_id", "arm", "repo", "rank_after_merge"],
  "properties": {
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "arm": {"type": "string", "enum": ["A", "B", "C", "M", "D"]},
    "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "rank_after_merge": {"type": "integer", "minimum": 1},
    "source_count": {"type": "integer", "minimum": 1}
  }
}
