# 复制本文件到本机（不要提交带真实值的副本）。
# 变量名与 AGENTS.md / 决策 0002 一致。

# 必填（探测时）：OpenAI 兼容聊天接口
# 大陆平台文档：https://platform.minimax.cn/docs/api-reference/text-openai-api
# 国际平台：https://api.minimax.io/v1；密钥与注册平台/区域匹配，401不一定是区域问题。
# 大陆现行文档列 api.minimax.cn；api.minimaxi.com 为用户已验证旧入口。以控制台为准。
OPENAI_BASE_URL=https://api.minimax.cn/v1
OPENAI_MODEL=MiniMax-M3
OPENAI_API_KEY=

# 可选：GitHub 搜索（无凭据时走公开配额）
GITHUB_TOKEN=

# 可选：单次探测超时秒数
BYOK_TIMEOUT_SECONDS=20

# 可选：输出长度上限（字符）
BYOK_MAX_OUTPUT_CHARS=64
