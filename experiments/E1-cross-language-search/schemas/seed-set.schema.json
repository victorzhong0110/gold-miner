{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "依据 protocol.md 第 2 节已知目标诊断字段。一行一条。不设 stars 下限。HelloGitHub 可选，不得当唯一来源。",
  "properties": {
    "seed_id": {
      "type": "string",
      "minLength": 1
    },
    "direction": {
      "type": "string",
      "enum": [
        "zh2en",
        "en2zh"
      ]
    },
    "type": {
      "description": "与开放题同一类型词。",
      "enum": [
        "term",
        "uncovered",
        "ambiguous",
        "negation",
        "long"
      ],
      "type": "string"
    },
    "repo": {
      "type": "string",
      "pattern": "^[^/\\s]+/[^/\\s]+$"
    },
    "stars": {
      "type": "integer",
      "minimum": 0
    },
    "stars_checked_at": {
      "description": "stars 快照时间，RFC 3339。",
      "format": "date-time",
      "type": "string"
    },
    "readme_lang": {
      "type": "string",
      "enum": [
        "zh_only",
        "bilingual",
        "en",
        "ja",
        "ko"
      ]
    },
    "source_kind": {
      "type": "string",
      "enum": [
        "community_doc",
        "github_readme",
        "github_search_api",
        "hellogithub",
        "topic_list",
        "w2_probe"
      ]
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "hellogithub_issue": {
      "type": "integer",
      "minimum": 1
    },
    "purpose_evidence": {
      "description": "用途与能力证据摘录（来自 description 或 README，不是编造）。",
      "minLength": 1,
      "type": "string"
    },
    "query": {
      "type": "string",
      "minLength": 1
    },
    "query_lang": {
      "type": "string",
      "enum": [
        "zh",
        "en"
      ]
    },
    "bias": {
      "description": "必须披露：由介绍反推查询。",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verification_method": {
      "description": "如何核对仓库存在与 stars。",
      "minLength": 1,
      "type": "string"
    },
    "low_heat": {
      "type": "boolean",
      "description": "本批记号：stars<100 为 true。不是排除条件。"
    },
    "readme_lang_version": {
      "type": "string",
      "minLength": 1
    },
    "source_blurb": {
      "type": "string",
      "minLength": 1
    },
    "discovered_at": {
      "type": "string",
      "format": "date-time"
    },
    "query_origin": {
      "type": "string",
      "const": "reverse_engineered_from_source_blurb"
    },
    "frozen_at": {
      "type": "string",
      "format": "date-time"
    },
    "bias_note": {
      "type": "string",
      "minLength": 1
    }
  },
  "title": "E1 verified seed-set.jsonl 单行记录",
  "type": "object",
  "anyOf": [
    {
      "required": [
        "seed_id",
        "direction",
        "type",
        "repo",
        "stars",
        "stars_checked_at",
        "readme_lang",
        "source_kind",
        "source_url",
        "purpose_evidence",
        "query",
        "query_lang",
        "bias",
        "verified_at",
        "verification_method"
      ]
    },
    {
      "required": [
        "seed_id",
        "direction",
        "repo",
        "stars",
        "low_heat",
        "readme_lang",
        "readme_lang_version",
        "source_kind",
        "source_url",
        "source_blurb",
        "discovered_at",
        "query",
        "query_lang",
        "query_origin",
        "frozen_at",
        "bias_note"
      ]
    }
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "source_kind": {
            "const": "hellogithub"
          }
        },
        "required": [
          "source_kind"
        ]
      },
      "then": {
        "required": [
          "hellogithub_issue"
        ]
      }
    }
  ],
  "required": [
    "direction",
    "query",
    "query_lang",
    "readme_lang",
    "repo",
    "seed_id",
    "source_kind",
    "source_url",
    "stars"
  ]
}
