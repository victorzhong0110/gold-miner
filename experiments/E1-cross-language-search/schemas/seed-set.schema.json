{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "依据 protocol.md 第 2 节已知目标诊断字段。一行一条。不设 stars 下限。HelloGitHub 可选，不得当唯一来源。",
  "properties": {
    "seed_id": {
      "description": "种子标识。",
      "minLength": 1,
      "type": "string"
    },
    "direction": {
      "description": "zh2en=中文查询找英文材料描述的目标；en2zh=英文查询找中文材料描述的目标。不强制整仓库仅一种语言。",
      "enum": ["en2zh", "zh2en"],
      "type": "string"
    },
    "type": {
      "description": "与开放题同一类型词。",
      "enum": ["term", "uncovered", "ambiguous", "negation", "long"],
      "type": "string"
    },
    "repo": {
      "description": "仓库全名 owner/repo，原样保存。",
      "pattern": "^[^/\\s]+/[^/\\s]+$",
      "type": "string"
    },
    "stars": {
      "description": "核对时的 stars 快照。允许 0。不得用下限排除冷门项目。",
      "minimum": 0,
      "type": "integer"
    },
    "stars_checked_at": {
      "description": "stars 快照时间，RFC 3339。",
      "format": "date-time",
      "type": "string"
    },
    "readme_lang": {
      "description": "人工或分类器标签。",
      "enum": ["zh_only", "bilingual", "en", "ja", "ko"],
      "type": "string"
    },
    "source_kind": {
      "description": "核对来源类型。hellogithub 只是其中一种。",
      "enum": [
        "github_search_api",
        "github_readme",
        "w2_probe",
        "community_doc",
        "hellogithub"
      ],
      "type": "string"
    },
    "source_url": {
      "description": "可复核的来源 URL。",
      "minLength": 1,
      "type": "string"
    },
    "hellogithub_issue": {
      "description": "可选月刊期号。",
      "minimum": 1,
      "type": "integer"
    },
    "purpose_evidence": {
      "description": "用途与能力证据摘录（来自 description 或 README，不是编造）。",
      "minLength": 1,
      "type": "string"
    },
    "query": {
      "description": "由介绍反推的需求句，不含仓库名。只作已知目标题。",
      "minLength": 1,
      "type": "string"
    },
    "query_lang": {
      "enum": ["zh", "en"],
      "type": "string"
    },
    "bias": {
      "description": "必须披露：由介绍反推查询。",
      "type": "string"
    },
    "verified_at": {
      "format": "date-time",
      "type": "string"
    },
    "verification_method": {
      "description": "如何核对仓库存在与 stars。",
      "minLength": 1,
      "type": "string"
    }
  },
  "required": [
    "seed_id",
    "direction",
    "type",
    "repo",
    "stars",
    "stars_checked_at",
    "readme_lang",
    "source_kind",
    "source_url",
    "purpose_evidence",
    "query",
    "query_lang",
    "bias",
    "verified_at",
    "verification_method"
  ],
  "title": "E1 verified seed-set.jsonl 单行记录",
  "type": "object"
}
