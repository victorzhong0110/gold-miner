{"$schema": "https://json-schema.org/draft/2020-12/schema", "additionalProperties": false, "description": "依据 protocol.md 第 7 节 judgments 字段列表，一行一条。各组前 10 合并去重、隐藏组别后判定，再回填到组。", "properties": {"hard_conditions": {"description": "硬条件判定。", "enum": ["satisfied", "conflict", "unknown"], "type": "string"}, "judge": {"description": "判定人标识。", "minLength": 1, "type": "string"}, "judged_at": {"description": "判定时间，RFC 3339。", "format": "date-time", "type": "string"}, "kind": {"description": "仓库种类。", "enum": ["tool", "library", "tutorial", "list", "mirror", "other"], "type": "string"}, "notes": {"description": "备注，可为空字符串。", "type": "string"}, "novel_to_judge": {"description": "对判定人是否首次见到。", "enum": ["yes", "no"], "type": "string"}, "purpose_fit": {"description": "用途适合度。", "enum": ["yes", "partial", "no"], "type": "string"}, "repo": {"description": "仓库全名 owner/repo，原样保存。", "pattern": "^[^/\\s]+/[^/\\s]+$", "type": "string"}, "run_id": {"description": "本次运行标识，对应 runs/<日期>-<标签>。", "minLength": 1, "type": "string"}, "task_id": {"description": "任务标识，dev/eval 组 id 或种子任务 id。", "minLength": 1, "type": "string"}}, "required": ["run_id", "task_id", "repo", "purpose_fit", "hard_conditions", "kind", "novel_to_judge", "judge", "judged_at", "notes"], "title": "E1 judgments.jsonl 单行记录", "type": "object"}
