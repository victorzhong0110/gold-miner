{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "title": "E1 seed-set.jsonl 单行记录",
  "description": "依据 protocol.md 第 2 节已知目标诊断。运行前把旧稿里「stars>=50 且必须有 hellogithub_issue」改成本结构：HelloGitHub 不能是唯一来源，低热度材料要留下，stars 原样记录、不作排除线。low_heat 只是本批记号（stars<100），不是产品结论。查询由来源短句反推，不把该短句写成用户需求证据。",
  "type": "object",
  "properties": {
    "seed_id": {"type": "string", "minLength": 1},
    "direction": {"type": "string", "enum": ["zh2en", "en2zh"]},
    "repo": {"type": "string", "pattern": "^[^/\\s]+/[^/\\s]+$"},
    "stars": {"type": "integer", "minimum": 0},
    "low_heat": {
      "type": "boolean",
      "description": "本批记号：stars<100 为 true。不是排除条件。"
    },
    "readme_lang": {
      "type": "string",
      "enum": ["zh_only", "bilingual", "en", "ja", "ko"]
    },
    "readme_lang_version": {"type": "string", "minLength": 1},
    "source_kind": {"type": "string", "enum": ["hellogithub", "topic_list"]},
    "source_url": {"type": "string", "minLength": 1},
    "source_blurb": {"type": "string", "minLength": 1},
    "hellogithub_issue": {"type": "integer", "minimum": 1},
    "discovered_at": {"type": "string", "format": "date-time"},
    "query": {"type": "string", "minLength": 1},
    "query_lang": {"type": "string", "enum": ["zh", "en"]},
    "query_origin": {
      "type": "string",
      "const": "reverse_engineered_from_source_blurb"
    },
    "frozen_at": {"type": "string", "format": "date-time"},
    "bias_note": {"type": "string", "minLength": 1}
  },
  "required": [
    "seed_id",
    "direction",
    "repo",
    "stars",
    "low_heat",
    "readme_lang",
    "readme_lang_version",
    "source_kind",
    "source_url",
    "source_blurb",
    "discovered_at",
    "query",
    "query_lang",
    "query_origin",
    "frozen_at",
    "bias_note"
  ],
  "allOf": [
    {
      "if": {
        "properties": {"source_kind": {"const": "hellogithub"}},
        "required": ["source_kind"]
      },
      "then": {"required": ["hellogithub_issue"]}
    }
  ]
}
