{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "E6 probe record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "run_id",
    "started_at",
    "finished_at",
    "elapsed_ms",
    "status",
    "model",
    "base_url",
    "protocol",
    "request_budget",
    "max_output_tokens",
    "actual_requests",
    "sent_requests",
    "retries",
    "cancelled_before_send",
    "cache_hits",
    "usage_prompt_tokens",
    "usage_completion_tokens",
    "usage_total_tokens",
    "visible_response_id",
    "response_format",
    "model_output",
    "http_status",
    "error_class",
    "error_detail",
    "billing_note",
    "prompt",
    "env_openai_api_key_set",
    "env_openai_base_url_set",
    "env_openai_model_set",
    "env_github_token_set"
  ],
  "properties": {
    "run_id": {"type": "string", "minLength": 1, "description": "本次探测标识，对应 runs/<日期>-<标签>/。"},
    "started_at": {"type": "string", "format": "date-time"},
    "finished_at": {"type": "string", "format": "date-time"},
    "base_url": {"type": "string", "description": "端点；未配置时为「未知」，不写猜测值。"},
    "model": {"type": "string", "description": "模型名；未配置时为「未知」。"},
    "protocol": {"type": "string", "minLength": 1},
    "max_output_tokens": {"type": "integer", "minimum": 0},
    "cancelled_before_send": {"type": "boolean"},
    "cache_hits": {"type": "integer", "minimum": 0},
    "visible_response_id": {"type": "string", "description": "可见响应 id；不可见时为「未知」。"},
    "response_format": {"type": "string", "description": "请求的 response_format；未指定时为「未知」。"},
    "error_detail": {"type": "string", "description": "错误细节，可为空字符串。"},
    "billing_note": {"type": "string", "minLength": 1, "description": "费用说明；未知时如实标注，不估算金额。"},
    "prompt": {"type": "string", "minLength": 1},
    "status": {"enum": ["未运行", "已运行", "取消", "失败"]},
    "error_class": {
      "enum": ["无", "未配置", "预算", "取消", "地址", "协议", "权限或凭据", "额度", "限流", "网络", "响应格式"]
    },
    "request_budget": {"enum": [0, 1]},
    "retries": {"const": 0},
    "actual_requests": {"enum": [0, 1]},
    "sent_requests": {"enum": [0, 1]},
    "elapsed_ms": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "未知"}]},
    "usage_prompt_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "未知"}]},
    "usage_completion_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "未知"}]},
    "usage_total_tokens": {"anyOf": [{"type": "integer", "minimum": 0}, {"const": "未知"}]},
    "model_output": {"type": "string"},
    "http_status": {"anyOf": [{"type": "integer"}, {"type": "null"}]},
    "env_openai_api_key_set": {"type": "boolean"},
    "env_openai_base_url_set": {"type": "boolean"},
    "env_openai_model_set": {"type": "boolean"},
    "env_github_token_set": {"type": "boolean"}
  }
}
